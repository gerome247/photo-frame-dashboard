diff --git a/arch/arm/dts/sun8i-a33-pf1007l-backup.dts b/arch/arm/dts/sun8i-a33-pf1007l-backup.dts
new file mode 100644
index 00000000..783593da
--- /dev/null
+++ b/arch/arm/dts/sun8i-a33-pf1007l-backup.dts
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * PF1007L backup build: the Q8 A33 tablet reference design, plus
+ * - eMMC on MMC2, 8-bit (as the boot-access notes observed on this PCB)
+ * - USB OTG forced to peripheral so the computer stays the host
+ * - no VBUS drive: the frame is powered from the host's VBUS
+ */
+
+#include "sun8i-a33-q8-tablet.dts"
+
+/ {
+	model = "PF1007L backup (Q8 A33 base)";
+};
+
+&mmc2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc2_8bit_pins>;
+	vmmc-supply = <&reg_dcdc1>;
+	bus-width = <8>;
+	non-removable;
+	cap-mmc-hw-reset;
+	status = "okay";
+};
+
+&usb_otg {
+	dr_mode = "peripheral";
+};
+
+&usbphy {
+	/delete-property/ usb0_vbus-supply;
+	/delete-property/ usb0_id_det-gpios;
+};
